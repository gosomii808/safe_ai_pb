generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum EventCategory {
  INTEREST_RATE
  INFLATION
  EMPLOYMENT
  GDP
  POLICY
  EARNINGS
  OTHER
}

enum ImportanceLevel {
  LOW
  MEDIUM
  HIGH
}

enum LogAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ONBOARDING_SUBMIT
  ANALYSIS_REQUEST
  OTHER
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                 String                    @id @default(cuid())
  nickname           String
  email              String // encrypted string
  phone              String // encrypted string
  ageRange           String?
  occupation         String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  investmentProfile  InvestmentProfile?
  portfolioAssets    PortfolioAsset[]
  analysisSnapshots  PortfolioAnalysisSnapshot[]
  accessLogs         AccessLog[]
  aiRequestLogs      AiRequestLog[]
  securityEvents     SecurityEvent[]

  @@unique([email])
  @@unique([phone])
}

model InvestmentProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  riskType              String   // encrypted string
  investmentGoal        String   // encrypted string
  investmentExperience  String?
  preferredAssets       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PortfolioAsset {
  id                String   @id @default(cuid())
  userId            String
  market            String
  ticker            String
  stockName         String?
  sector            String?
  quantity          String   // encrypted string
  avgBuyPrice       String?  // encrypted string
  investmentAmount  String?  // encrypted string
  targetRatio       Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, market, ticker])
  @@index([ticker])
}

model PortfolioAnalysisSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  snapshotDate       DateTime @default(now())
  totalValue         Float
  dailyPnL           Float?
  riskScore          Float?
  diversification    Float?
  summary            String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, snapshotDate])
}

model MarketPrice {
  id          String   @id @default(cuid())
  market      String
  ticker      String
  price       Float
  currency    String
  priceDate   DateTime
  source      String?
  createdAt   DateTime @default(now())

  @@unique([market, ticker, priceDate])
  @@index([ticker, priceDate])
}

model MarketIndex {
  id           String   @id @default(cuid())
  indexCode    String
  indexName    String
  value        Float
  change       Float?
  changeRate   Float?
  indexDate    DateTime
  source       String?
  createdAt    DateTime @default(now())

  @@unique([indexCode, indexDate])
  @@index([indexDate])
}

model ValuationIndicator {
  id          String   @id @default(cuid())
  market      String
  ticker      String
  per         Float?
  pbr         Float?
  eps         Float?
  bps         Float?
  indicatorDate DateTime
  source      String?
  createdAt   DateTime @default(now())

  @@unique([market, ticker, indicatorDate])
}

model ForeignOwnership {
  id             String   @id @default(cuid())
  market         String
  ticker         String
  ownershipRatio Float
  netBuyAmount   Float?
  ownershipDate  DateTime
  source         String?
  createdAt      DateTime @default(now())

  @@unique([market, ticker, ownershipDate])
}

model YahooPrice {
  id          String   @id @default(cuid())
  symbol      String
  open        Float?
  high        Float?
  low         Float?
  close       Float
  adjClose    Float?
  volume      Float?
  priceDate   DateTime
  createdAt   DateTime @default(now())

  @@unique([symbol, priceDate])
  @@index([symbol, priceDate])
}

model EconomicEvent {
  id              String           @id @default(cuid())
  eventDate       DateTime
  title           String
  category        EventCategory
  country         String
  importance      ImportanceLevel
  description     String
  affectedAssets  String
  source          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  impactRules     EventImpactRule[]

  @@unique([eventDate, title, country])
  @@index([eventDate])
}

model EventImpactRule {
  id               String        @id @default(cuid())
  economicEventId  String
  eventCategory    EventCategory
  condition        String
  affectedAsset    String
  expectedImpact   String
  explanation      String
  riskLevel        RiskLevel
  createdAt        DateTime      @default(now())
  economicEvent    EconomicEvent @relation(fields: [economicEventId], references: [id], onDelete: Cascade)

  @@unique([economicEventId, condition, affectedAsset])
  @@index([eventCategory])
}

model AccessLog {
  id            String    @id @default(cuid())
  userId        String?
  action        LogAction
  endpoint      String
  method        String
  ipAddress     String?
  userAgent     String?
  success       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AiRequestLog {
  id             String   @id @default(cuid())
  userId         String?
  requestType    String
  modelName      String?
  promptHash     String?
  tokenUsage     Int?
  latencyMs      Int?
  success        Boolean  @default(true)
  errorCode      String?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([requestType, createdAt])
}

model SecurityEvent {
  id             String           @id @default(cuid())
  userId         String?
  eventType      String
  severity       SecuritySeverity
  description    String
  metadata       String?
  ipAddress      String?
  createdAt      DateTime         @default(now())
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([severity, createdAt])
  @@index([userId, createdAt])
}
